# Build output
bin/

# Release artifacts, from either `task release:` target
dist/

# Root-anchored binaries left by `go build ./cmd/<name>/` without -o.
/ic11c
/ic11c.exe
/isagen

# Test binaries from `go test -c`
*.test

# Coverage profiles. coverage.out is what `task test` and CI write;
# .coverage-ephemeral.out is the sanitized profile `task cov` browses.
coverage.out
.coverage-ephemeral.out

# Decompiled game source written by `task isa:csharp:source`. The digest beside
# it is checked in; this is the game's own code and is not.
/tools/gamesrc/source*/

# Editors and agents
.vscode/
.idea/
.claude
.zed

# OS
.DS_Store
